PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ndmu_ticketing

# JWT Authentication (generate distinct long random values; never commit real secrets)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_DAYS=7
REFRESH_COOKIE_NAME=ndmu_refresh_token

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
GOOGLE_ALLOWED_DOMAIN=ndmu.edu.ph

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Ticket System Configuration
DEFAULT_AUTO_CLOSE_DAYS=3
CLIENT_URL=http://localhost:5173
MIS_CONTACT_EMAIL=mis@ndmu.edu.ph
