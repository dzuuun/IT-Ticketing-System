{
  "name": "ndmu-it-ticketing-system",
  "version": "1.0.0",
  "description": "Notre Dame of Marbel University - MIS IT Ticketing System",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon index.js",
    "seed": "node scripts/seed.js",
    "client": "npm run dev --prefix client",
    "client:build": "cd client && npm run build",
    "install:all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "8.1.0",
    "google-auth-library": "10.3.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.7",
    "nodemailer": "^6.9.13",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "nodemon": "^3.1.0"
  },
  "keywords": [
    "ndmu",
    "mis",
    "it-ticketing",
    "helpdesk",
    "mysql",
    "express",
    "react"
  ],
  "author": "NDMU MIS",
  "license": "ISC"
}
